# Chillion Agents — environment template
# Copy to .env and fill in locally. Never commit .env.

DATABASE_URL=sqlite:///./chillion_agents.db
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional integrations
GOOGLE_API_KEY=
OPENAI_API_KEY=
CALENDLY_ACCESS_TOKEN=
CALENDLY_USER_URI=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# People search (server-side only; never expose to the frontend)
PROSPEO_API_KEY=

FRONTEND_URL=http://localhost:3000
RAG_DOCS_PATH=./docs/chillion_products
