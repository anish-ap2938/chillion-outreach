# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets; .env.example is safe to share
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Local databases
/prisma/dev.db
/prisma/dev.db-journal
/prisma/prisma/
/chillion_agents/**/*.db
/chillion_agents/chroma_db/

# Python
**/__pycache__/
**/*.pyc
**/*.pyo

# Cursor IDE local state
.cursor/

# Agent runtime / vector store
/chillion_agents/chroma_db/
/chillion_agents/data/
/chillion_agents/.env
/chillion_agents/.env.local
/chillion_agents/.env.*.local
!/chillion_agents/.env.example

# Secrets — never commit
*.pem
**/credentials.json
**/secrets.json
